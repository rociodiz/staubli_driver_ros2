<?xml version="1.0"?>
<!-- |                         Staubli eye-in-hand RGB camera                     | -->
<!-- |                                                                           | -->
<!-- | Eye-in-hand camera mounted on link_6 of the TX2-60L (same Z as tool0).    | -->
<!-- | Integrated with real support + sensor STL (SENSOR_BASE.stl).              | -->
<!-- |                                                                           | -->
<!-- | The STL contains the complete physical support + sensor. The virtual      | -->
<!-- | camera geometry is removed to avoid duplication. camera_link is a frame   | -->
<!-- | (no visual) with the sensor placed on the inclined face of the support.  | -->
<!-- | Orientation estimation is pending validation (see comments).             | -->
<!-- =========================================================================== -->

<robot xmlns:xacro="http://wiki.ros.org/xacro">

    <xacro:macro name="staubli_camera" params="
        robot_prefix:=''
        parent_link
        update_rate:=30
        width:=640
        height:=480
        hfov:=1.0472
    ">
        <!-- Support + sensor physical geometry (STL) -->
        <link name="${robot_prefix}sensor_support_link">
            <inertial>
                <mass value="0.5"/>
                <inertia
                    ixx="0.001846" ixy="0.0" ixz="0.0"
                    iyy="0.000599" iyz="0.0" izz="0.002171"/>
            </inertial>
            <!-- Visual 1: metallic structure of the support (components >= 30 mm) -->
            <visual name="sensor_support_visual_structure">
                <geometry>
                    <mesh
                        filename="package://staubli_robot_description/meshes/SENSOR_BASE_structure.stl"
                        scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="sensor_support_structure_material">
                    <color rgba="0.35 0.37 0.39 1.0"/>
                </material>
            </visual>
            <!-- Visual 2: dark sensor housing + small hardware (components < 30 mm) -->
            <visual name="sensor_support_visual_dark">
                <geometry>
                    <mesh
                        filename="package://staubli_robot_description/meshes/SENSOR_BASE_dark.stl"
                        scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="sensor_support_dark_material">
                    <color rgba="0.12 0.13 0.14 1.0"/>
                </material>
            </visual>

            <!-- Visual 3: FOV plane of the sensor (fan extracted from SENSOR_BASE.stl,
                 1108 triangles, identical geometry and pose: x -70.187..464.813,
                 y -19.829..-19.819, z -411.451..440.826 mm) -->
            <visual name="sensor_support_visual_plane">
                <geometry>
                    <mesh
                        filename="package://staubli_robot_description/meshes/SENSOR_BASE_plane.stl"
                        scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="sensor_support_plane_material">
                    <color rgba="1.0 1.0 1.0 0.25"/>
                </material>
            </visual>

            <!-- Visual 4: red line on the far edge of the FOV plane.
                 Same logic as the old laser_line_visual (thin box, laser_line_width
                 thick) laid along the final edge of the plane:
                 x = 464.813 mm, y = -19.825 mm, z -411.451..440.826 mm -->
            <xacro:property name="laser_line_width" value="0.008"/>
            <visual name="sensor_support_visual_line">
                <origin xyz="0.464813 -0.019825 0.0146875" rpy="0 0 0"/>
                <geometry>
                    <box size="${laser_line_width} ${laser_line_width} 0.852277"/>
                </geometry>
                <material name="sensor_support_line_material">
                    <color rgba="1.0 0.0 0.0 1.0"/>
                </material>
            </visual>
            <collision name="sensor_support_collision">
                <geometry>
                    <mesh
                        filename="package://staubli_robot_description/meshes/SENSOR_BASE.stl"
                        scale="0.001 0.001 0.001"/>
                </geometry>
            </collision>
        </link>

        <!-- Joint: tool0 -> sensor_support_link -->
        <!-- TODO: validation pending - transformation from tool0 to support may need fine adjustment -->
        <joint name="${robot_prefix}sensor_support_joint" type="fixed">
            <parent link="${parent_link}"/>
            <child link="${robot_prefix}sensor_support_link"/>
            <origin xyz="-0.003110 0.016130 0.168690" rpy="0 -1.570796 1.570796"/>
        </joint>

        <!-- Camera frame (no geometry) - reference for real sensor -->
        <!-- TODO: ESTIMATION PENDING VALIDATION
             Position/orientation obtained from geometric analysis of STL (surface inclined).
             Origin at center of inclined face. -Z_local(camera_link) aligned with estimated
             observation direction (+n_patch). May require adjustment after Gazebo verification. -->
        <link name="${robot_prefix}camera_link">
            <inertial>
                <mass value="0.5"/>
                <inertia
                    ixx="1.0e-6" ixy="0.0" ixz="0.0"
                    iyy="1.0e-6" iyz="0.0" izz="1.0e-6"/>
            </inertial>
        </link>

        <!-- Joint: sensor_support_link -> camera_link -->
        <joint name="${robot_prefix}camera_fixed_joint" type="fixed">
            <parent link="${robot_prefix}sensor_support_link"/>
            <child link="${robot_prefix}camera_link"/>
            <origin xyz="-0.064522 0.088917 0.014688" rpy="1.570796 0 -0.331612"/>
        </joint>

        <!-- Gazebo Sim RGB camera sensor (simple configuration, no depth). -->
        <gazebo reference="${robot_prefix}camera_link">
            <sensor name="camera" type="camera">
                <topic>/camera/image_raw</topic>
                <update_rate>${update_rate}</update_rate>
                <always_on>1</always_on>
                <visualize>true</visualize>
                <camera>
                    <horizontal_fov>${hfov}</horizontal_fov>
                    <image>
                        <width>${width}</width>
                        <height>${height}</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.1</near>
                        <far>100</far>
                    </clip>
                </camera>
            </sensor>
        </gazebo>

    </xacro:macro>

</robot>
