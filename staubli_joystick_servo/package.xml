<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>staubli_joystick_servo</name>
  <version>0.0.1</version>
  <description>
    Control cartesiano por velocidad del Staubli TX2-60L sin MoveIt:
    convierte /cmd_vel (geometry_msgs/Twist, frame base_link) en velocidades
    articulares mediante el Jacobiano de PyKDL (Damped Least Squares) y las
    publica en /forward_velocity_controller/commands.
  </description>
  <maintainer email="rocio@example.com">rocio</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>buildtool_ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>staubli_trajectory</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>