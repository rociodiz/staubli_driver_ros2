<?xml version="1.0" ?>
<!--
  Simulated inspection cell for the Staubli TX2-60.

  World layout (all poses in the world frame, z up):
    - Ground plane + sun (same as the vendor `empty.sdf`).
    - Inspection table: 1.0 x 0.6 m top, surface at z = 0.50 m,
      centered around (0.00, 0.50) in X/Y. Legs span from the floor
      (z = 0) up to the slab underside (z = 0.45).
    - robot_platform: 0.30 x 0.30 x 0.30 m box centered at (0, 0),
      resting on the floor, as an elevated base for the robot.
    - Three static workpieces on the table:
        part_1: box        0.08 x 0.08 x 0.08   at (0.00, 0.41, 0.54)
        part_2: cylinder   r = 0.05, h = 0.08   at (0.13, 0.46, 0.54)
        part_3: plate      0.12 x 0.10 x 0.025  at (-0.13, 0.44, 0.5125)

  The robot itself is spawned separately by `ros_gz_sim create` from
  /robot_description, so it is NOT part of this world file.
-->
<sdf version="1.6">
  <world name="inspection_cell">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-contact-system"
      name="gz::sim::systems::Contact">
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Inspection table: 1.0 x 0.6 m top, surface at z = 0.50 m,
         centered at X/Y = (0.00, 0.50). Model pose places the top box
         (0.05 m thick, centered at the model origin) from z = 0.45 to
         0.50 in world. Legs (length 0.450, local z -0.250) span from
         the floor (world z = 0) to the slab underside (world z = 0.45). -->
    <model name="inspection_table">
      <static>true</static>
      <pose>0.00 0.50 0.475 0 0 0</pose>
      <link name="table_link">
        <visual name="table_top_visual">
          <geometry>
            <box>
              <size>1.0 0.6 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.77 0.78 0.77 1</ambient>
            <diffuse>0.77 0.78 0.77 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <collision name="table_top_collision">
          <geometry>
            <box>
              <size>1.0 0.6 0.05</size>
            </box>
          </geometry>
        </collision>

        <visual name="table_leg_1_visual">
          <pose>0.45 -0.275 -0.250 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.025</radius>
              <length>0.450</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.30 0.30 0.30 1</ambient>
            <diffuse>0.30 0.30 0.30 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="table_leg_1_collision">
          <pose>0.45 -0.275 -0.250 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.025</radius>
              <length>0.450</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name="table_leg_2_visual">
          <pose>-0.45 -0.275 -0.250 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.025</radius>
              <length>0.450</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.30 0.30 0.30 1</ambient>
            <diffuse>0.30 0.30 0.30 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="table_leg_2_collision">
          <pose>-0.45 -0.275 -0.250 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.025</radius>
              <length>0.450</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name="table_leg_3_visual">
          <pose>0.45 0.275 -0.250 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.025</radius>
              <length>0.450</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.30 0.30 0.30 1</ambient>
            <diffuse>0.30 0.30 0.30 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="table_leg_3_collision">
          <pose>0.45 0.275 -0.250 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.025</radius>
              <length>0.450</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name="table_leg_4_visual">
          <pose>-0.45 0.275 -0.250 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.025</radius>
              <length>0.450</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.30 0.30 0.30 1</ambient>
            <diffuse>0.30 0.30 0.30 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="table_leg_4_collision">
          <pose>-0.45 0.275 -0.250 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.025</radius>
              <length>0.450</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Elevated base under the robot: the real robot has a controller/base
         underneath, so the robot stands ~0.30 m higher. Box 0.30 x 0.30 x 0.30 m,
         centered at (0, 0), resting on the floor (pose z = 0.15 m).
         The robot is spawned separately (ros_gz_sim create) at z = 0.30. -->
    <model name="robot_platform">
      <static>true</static>
      <pose>0.0 0.0 0.15 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.30 0.30 0.30</size>
            </box>
          </geometry>
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.30 0.30 0.30</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Workpieces on the table (bases at z = 0.50 m). -->
    <model name="part_1">
      <static>true</static>
      <pose>0.00 0.41 0.54 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.08 0.08 0.08</size>
            </box>
          </geometry>
          <material>
            <ambient>0.0 0.7 0.1 1</ambient>
            <diffuse>0.0 0.7 0.1 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.08 0.08 0.08</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="part_2">
      <static>true</static>
      <pose>0.13 0.46 0.54 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>0.08</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.0 0.3 0.8 1</ambient>
            <diffuse>0.0 0.3 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>0.08</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="part_3">
      <static>true</static>
      <pose>-0.13 0.44 0.5125 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.12 0.10 0.025</size>
            </box>
          </geometry>
          <material>
            <ambient>0.53 0.52 0.51 1</ambient>
            <diffuse>0.53 0.52 0.51 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.12 0.10 0.025</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

  </world>
</sdf>